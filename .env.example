# Токен вашего Discord бота (получить на https://discord.com/developers/applications)
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE

# Префикс для текстовых команд (основное управление через слэш-команды /)
COMMAND_PREFIX=!

# Опционально: Прокси-сервер (HTTP/HTTPS/SOCKS5), если Discord заблокирован или недоступен напрямую
# Например: http://127.0.0.1:10808 или socks5://127.0.0.1:1080
DISCORD_PROXY=
